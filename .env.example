# Runtime Profile ("production" is fail-closed default; set "test" only in isolated test suites)
HYDB_PROFILE=production

# Cluster & Admin Secrets (REQUIRED in production; minimum 16 bytes each, and must differ from each other)
HYDB_CLUSTER_SECRET=replace-with-random-32-byte-cluster-secret
HYDB_ADMIN_TOKEN=replace-with-distinct-32-byte-admin-token

# Configured Cluster Membership & Quorum Sizing
HYDB_CLUSTER_MEMBERS=sd-node-1,sd-node-2,sd-node-3
HYDB_CLUSTER_SIZE=3
HYDB_NODE_ID=sd-node-1

# HyperBEAM Device Endpoints
HB_URL=http://127.0.0.1:8734
SU_URL=http://127.0.0.1:8735/~sd@1.0
ARLOCAL_URL=http://127.0.0.1:1984
ARWEAVE_GATEWAY=http://127.0.0.1:1984
NODE_PORT=8734
SU_PORT_1=8735
SU_PORT_2=8745
SU_PORT_3=8755
ARLOCAL_PORT=1984

# Durable Persistence Paths
HYDB_WAL_PATH=./data/node_sd_1/wal.log
HYDB_EPOCH_PATH=./data/node_sd_1/epoch.meta
HYDB_HOT_WAL_PATH=./data/node/hot_wal.log
HYDB_HOT_EPOCH_PATH=./data/node/hot_epoch.meta
HYDB_MEMBERSHIP_PATH=./data/node/cluster_membership.meta
HYDB_RECONCILE_WAL_PATH=./data/node_sd_1/wal.log,./data/node_sd_2/wal.log,./data/node_sd_3/wal.log
HYDB_COMMITTER_CURSOR_PATH=./ao_process/committer_cursor.json

# Layer 4 AO Committer & L1 Finality Verification
VERIFY_L1_FINALITY=false
L1_GATEWAYS=https://arweave.net,https://ar-io.dev
MIN_CONFIRMATIONS=1
REQUIRE_MULTI_GATEWAY=false

# AO Genesis Stack & Arbitrator Settlement
AO_GATEWAY_URL=http://127.0.0.1:8735/ao
AO_MU_URL=https://mu.ao-testnet.xyz
AO_CU_URL=https://cu.ao-testnet.xyz
AO_GENESIS_ID=
AO_GENESIS_HASH=
AO_PROCESS_ID=
