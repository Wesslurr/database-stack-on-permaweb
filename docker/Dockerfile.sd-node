FROM erlang:27-slim

# Install system dependencies (pure Erlang 27 runtime, zero Node.js sidecar)
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    ca-certificates \
    bash \
    build-essential \
    cmake \
    git \
    python3 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy full application code
COPY . .

# Set execution permissions for distribution scripts
RUN chmod +x ./scripts/*.sh 2>/dev/null || true

ENV HYDB_PROFILE=production

CMD ["./scripts/run-sd-node-foreground.sh"]
