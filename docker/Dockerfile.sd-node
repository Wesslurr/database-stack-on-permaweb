FROM erlang:27-slim

# Install system dependencies (pure Erlang 27 runtime, zero Node.js sidecar)
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    ca-certificates \
    bash \
    build-essential \
    cmake \
    git \
    python3 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy full application code
COPY . .

# Set execution permissions for distribution scripts
RUN chmod +x ./scripts/*.sh ./scripts/*.escript 2>/dev/null || true

# Pre-compile Erlang runtime and native committer modules into library path
RUN mkdir -p /app/sd/out/ebin && \
    erlc -I /app/sd/src -o /app/sd/out/ebin /app/sd/src/*.erl

ENV ERL_LIBS="/app/sd/out/ebin:${ERL_LIBS:-}"
ENV HYDB_PROFILE=production

CMD ["./scripts/run-sd-node-foreground.sh"]
